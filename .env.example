# Local SQLite — zero setup. For production, swap to a Postgres URL
# (Neon, Railway, or Vercel Postgres all have free tiers) and change
# the provider in prisma/schema.prisma from "sqlite" to "postgresql".
DATABASE_URL="file:./dev.db"

# Long random string used to sign admin session tokens.
# Generate one with: openssl rand -base64 32
JWT_SECRET="replace-with-a-long-random-string"

# Used once by `npm run db:seed` to create the admin login.
# Change the password after first login isn't supported yet —
# just re-run db:seed with a new password to rotate it.
ADMIN_EMAIL="coach@sankarchessacademy.in"
ADMIN_PASSWORD="ChangeThisPassword123!"
ADMIN_NAME="Sankar Balaga"
